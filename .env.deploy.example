# ============================================================
# Configuración para scripts/deploy-remote.sh
# Copiá este archivo como .env.deploy y editá los valores.
# .env.deploy está en .gitignore — no se sube al repo.
# ============================================================

# Alias en tu ~/.ssh/config o IP directa
DEPLOY_SSH_HOST=Nexus

# Usuario SSH
DEPLOY_SSH_USER=root

# Puerto SSH (default 22)
DEPLOY_SSH_PORT=22

# Path absoluto donde está clonado el repo en el servidor
DEPLOY_REMOTE_PATH=/opt/services/jtcp

# Archivo docker-compose que usa producción
DEPLOY_COMPOSE_FILE=infra/docker-compose.prod.yml

# Rama que se despliega (siempre debería ser main)
DEPLOY_BRANCH=main

# URL para healthcheck post-deploy (desde el server, internal port)
HEALTH_URL=http://localhost:8000/health
