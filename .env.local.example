# ============================================================
# Variables para desarrollo LOCAL (sin Docker)
# Copiar como .env.local
# ============================================================

APP_ENV=development

PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001
API_BASE_URL=http://localhost:8000

# SQLite en carpeta local del proyecto
DATABASE_URL=sqlite:///./data/app.db

MEDIA_ROOT=./storage/media
MEDIA_PUBLIC_URL=http://localhost:8000/media

JWT_SECRET=dev_secret_local_no_usar_en_produccion
JWT_EXPIRE_MINUTES=1440

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

UMAMI_DB_PASSWORD=dev_password
UMAMI_APP_SECRET=dev_secret
UMAMI_WEBSITE_ID=

INITIAL_ADMIN_EMAIL=admin@local.dev
INITIAL_ADMIN_PASSWORD=admin123

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
