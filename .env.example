# ============================================================
# Juanma & The Center People — Variables de entorno
# PLANTILLA DE LA APP. No se usa directamente.
# Copiar como .env y completar los valores reales.
# NUNCA subir .env al repositorio
# ============================================================

# ─── General ────────────────────────────────────────────────
APP_ENV=development

# URLs del proyecto (sin barra final)
PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001
API_BASE_URL=http://localhost:8000

# ─── Base de datos API (SQLite) ──────────────────────────────
DATABASE_URL=sqlite:////app/data/app.db

# ─── Storage ────────────────────────────────────────────────
MEDIA_ROOT=/media/juanma-center-people
MEDIA_PUBLIC_URL=http://localhost:8000/media

# ─── Autenticación ──────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_string_aleatorio_de_64_caracteres
JWT_EXPIRE_MINUTES=1440

# ─── Email SMTP (Zoho Mail u otro proveedor SMTP) ───────────
# Para Zoho Mail (https://www.zoho.com/mail/):
#   SMTP_HOST=smtp.zoho.com  |  SMTP_PORT=587  |  SMTP_USE_TLS=true
# Las 5 cuentas usan el mismo servidor saliente. Completar solo emails/passwords.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_FROM_NAME=Tu Marca
SMTP_USE_TLS=true

# Cuentas por escenario:
# - fan/other del formulario -> EMAIL_CONTACT
# - booking/collaboration -> EMAIL_BOOKING
# - press -> EMAIL_PRESS
# - gestión interna -> EMAIL_ADMIN
# - descargas aprobadas y automatismos -> EMAIL_NOREPLY
EMAIL_CONTACT=contacto@tudominio.com
EMAIL_CONTACT_PASSWORD=
EMAIL_BOOKING=booking@tudominio.com
EMAIL_BOOKING_PASSWORD=
EMAIL_PRESS=prensa@tudominio.com
EMAIL_PRESS_PASSWORD=
EMAIL_ADMIN=admin@tudominio.com
EMAIL_ADMIN_PASSWORD=
EMAIL_NOREPLY=noreply@tudominio.com
EMAIL_NOREPLY_PASSWORD=

# ─── Analytics (Umami) ──────────────────────────────────────
UMAMI_DB_PASSWORD=cambia_esto_por_password_seguro
UMAMI_APP_SECRET=cambia_esto_por_otro_string_aleatorio
# Completar luego de levantar Umami y crear el sitio
UMAMI_WEBSITE_ID=

# ─── Admin inicial (solo para script de seed) ───────────────
INITIAL_ADMIN_EMAIL=admin@juanma.com
INITIAL_ADMIN_PASSWORD=cambia_esto_en_produccion

# ─── Traefik (solo producción) ───────────────────────────────
TRAEFIK_NETWORK=nexus_main_net
DOMAIN=juanma.com
CERT_RESOLVER=letsencrypt

# ─── CORS ───────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
