# ============================================================
# Juanma & The Center People — Variables de entorno
# Copiar como .env y completar los valores reales
# NUNCA subir .env al repositorio
# ============================================================

# ─── General ────────────────────────────────────────────────
APP_ENV=development

# URLs del proyecto (sin barra final)
PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001
API_BASE_URL=http://localhost:8000

# ─── Base de datos API (SQLite) ──────────────────────────────
DATABASE_URL=sqlite:////app/data/app.db

# ─── Storage ────────────────────────────────────────────────
MEDIA_ROOT=/media/juanma-center-people
MEDIA_PUBLIC_URL=http://localhost:8000/media

# ─── Autenticación ──────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_string_aleatorio_de_64_caracteres
JWT_EXPIRE_MINUTES=1440

# ─── Email (Mailgun) ─────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.tudominio.com
MAILGUN_FROM_EMAIL=noreply@mg.tudominio.com
ADMIN_NOTIFICATION_EMAIL=admin@tudominio.com

# ─── Analytics (Umami) ──────────────────────────────────────
UMAMI_DB_PASSWORD=cambia_esto_por_password_seguro
UMAMI_APP_SECRET=cambia_esto_por_otro_string_aleatorio
# Completar luego de levantar Umami y crear el sitio
UMAMI_WEBSITE_ID=

# ─── Admin inicial (solo para script de seed) ───────────────
INITIAL_ADMIN_EMAIL=admin@juanma.com
INITIAL_ADMIN_PASSWORD=cambia_esto_en_produccion

# ─── Traefik (solo producción) ───────────────────────────────
TRAEFIK_NETWORK=nexus_main_net
DOMAIN=juanma.com
CERT_RESOLVER=letsencrypt

# ─── CORS ───────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
