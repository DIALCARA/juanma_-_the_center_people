---
interface Props {
  items: string[];
}
const { items } = Astro.props;

// Cada "half" del track debe ser al menos tan ancho como el viewport, sino
// queda hueco visible mientras la animación se desplaza. Garantizamos al
// menos 8 items por half (suficiente para llenar ~3000px aun con frases cortas).
const MIN_ITEMS_PER_HALF = 8;
const repeats = Math.max(1, Math.ceil(MIN_ITEMS_PER_HALF / Math.max(items.length, 1)));
const half = Array.from({ length: repeats }).flatMap(() => items);
// Duplicamos el half para que el loop sea continuo sin "salto" visible.
const loop = [...half, ...half];
---

{items.length > 0 && (
  <div class="marquee bg-red-band/90 text-bone py-3 border-y border-red-dark" aria-label="Novedades">
    <div class="marquee__track font-heading uppercase tracking-widest text-sm">
      {loop.map((item) => (
        <span class="inline-flex items-center gap-3">
          <span aria-hidden="true">★</span>
          {item}
        </span>
      ))}
    </div>
  </div>
)}
