---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import { getSiteSettings, getSections } from "../lib/api";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  hideFooter?: boolean;
  hideHeader?: boolean;
}

const { title, description, ogImage, noindex = false, jsonLd, breadcrumbs, hideFooter = false, hideHeader = false } = Astro.props;

let siteData: any = null;
let sections: any[] = [];
try {
  const [siteRes, sectionsRes] = await Promise.all([
    getSiteSettings(),
    getSections(),
  ]);
  siteData = siteRes.data;
  sections = sectionsRes.data ?? [];
} catch (e) {
  // API no disponible — usar defaults
}

const bandName = siteData?.band_name ?? "Juanma & The Center People";
const pageTitle = title ? `${title} | ${bandName}` : bandName;
const pageDesc = description ?? siteData?.tagline ?? "Rock alternativo peruano";
// Leemos en runtime (process.env) para que cambiar UMAMI_* o APP_ENV en .env
// no requiera rebuild del bundle — basta con recrear el contenedor.
const umamiWebsiteId = process.env.UMAMI_WEBSITE_ID ?? "";
const umamiUrl = process.env.UMAMI_URL ?? "";
const isProd = process.env.APP_ENV === "production";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/png" href="/logo-dark.png" />
    <link rel="apple-touch-icon" href="/logo-dark.png" />

    <!-- Preconnect a Google Fonts: reduce ~100-200ms en first paint -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Preload del logo del hero: reduce LCP -->
    <link rel="preload" as="image" href="/logo-light.png" fetchpriority="high" />

    <SEO
      title={pageTitle}
      description={pageDesc}
      ogImage={ogImage}
      noindex={noindex}
      siteData={siteData}
      jsonLd={jsonLd}
      breadcrumbs={breadcrumbs}
    />
    <!-- Umami analytics (solo en producción) -->
    {isProd && umamiWebsiteId && umamiUrl && (
      <script
        defer
        src={`${umamiUrl}/script.js`}
        data-website-id={umamiWebsiteId}
      />
    )}
  </head>
  <body>
    <!-- Skip link para accesibilidad -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 btn-primary"
    >
      Ir al contenido principal
    </a>

    {!hideHeader && (
      <Header bandName={bandName} siteData={siteData} sections={sections} />
    )}

    <main id="main-content">
      <slot />
    </main>

    {!hideFooter && <Footer siteData={siteData} />}

    <!-- Reveal animation script -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
