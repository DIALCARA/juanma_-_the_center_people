---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionUnavailable from "../components/ui/SectionUnavailable.astro";
import { getSectionInfo } from "../lib/api";

const section = await getSectionInfo("contacto");

const tipo = Astro.url.searchParams.get("tipo") ?? "";
const tipoMap: Record<string, string> = {
  booking: "booking",
  prensa: "press",
  colaboracion: "collaboration",
};
const selectedType = tipoMap[tipo] ?? "";
---

<BaseLayout title={section.title || "Contacto"} description="Contacto y booking de Juanma & The Center People">
  {!section.isEnabled && (
    <SectionUnavailable title={section.title || "Contacto"} message={section.message} />
  )}
  {section.isEnabled && (
    <Fragment>
  <!-- CABECERA -->
  <section class="py-20 px-4 text-center" aria-label="Contacto">
    <div class="max-w-3xl mx-auto">
      <p class="font-heading text-red-band text-xs uppercase tracking-widest mb-3">Escribinos</p>
      <h1 class="font-heading text-5xl md:text-6xl text-bone uppercase tracking-widest mb-6">
        Contacto
      </h1>
      <p class="text-bone-muted font-light">
        Booking, prensa, colaboraciones o simplemente saludarnos.
      </p>
    </div>
  </section>

  <!-- FORMULARIO -->
  <section class="py-12 px-4 reveal" aria-label="Formulario de contacto">
    <div class="max-w-xl mx-auto">
      <form id="contact-form" novalidate>
        <!-- Tipo de contacto -->
        <div class="mb-6">
          <label for="contact_type" class="block font-heading text-bone uppercase tracking-wider text-xs mb-2">
            Motivo *
          </label>
          <select
            id="contact_type"
            name="contact_type"
            required
            class="w-full bg-black border border-urban-700 text-bone px-4 py-3 font-body text-sm focus:outline-none focus:border-red-band transition-colors"
          >
            <option value="" disabled selected={!selectedType}>Seleccioná un motivo</option>
            <option value="booking" selected={selectedType === "booking"}>Booking / Contratación</option>
            <option value="press" selected={selectedType === "press"}>Prensa / Medios</option>
            <option value="collaboration" selected={selectedType === "collaboration"}>Colaboración artística</option>
            <option value="fan">Mensaje de fan</option>
            <option value="other">Otro</option>
          </select>
        </div>

        <!-- Nombre -->
        <div class="mb-6">
          <label for="name" class="block font-heading text-bone uppercase tracking-wider text-xs mb-2">
            Nombre *
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            minlength="2"
            maxlength="100"
            autocomplete="name"
            class="w-full bg-black border border-urban-700 text-bone px-4 py-3 font-body text-sm focus:outline-none focus:border-red-band transition-colors placeholder-urban-600"
            placeholder="Tu nombre"
          />
        </div>

        <!-- Email -->
        <div class="mb-6">
          <label for="email" class="block font-heading text-bone uppercase tracking-wider text-xs mb-2">
            Email *
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full bg-black border border-urban-700 text-bone px-4 py-3 font-body text-sm focus:outline-none focus:border-red-band transition-colors placeholder-urban-600"
            placeholder="tu@email.com"
          />
        </div>

        <!-- Mensaje -->
        <div class="mb-8">
          <label for="message" class="block font-heading text-bone uppercase tracking-wider text-xs mb-2">
            Mensaje *
          </label>
          <textarea
            id="message"
            name="message"
            required
            minlength="10"
            maxlength="2000"
            rows="6"
            class="w-full bg-black border border-urban-700 text-bone px-4 py-3 font-body text-sm focus:outline-none focus:border-red-band transition-colors placeholder-urban-600 resize-vertical"
            placeholder="Escribí tu mensaje acá..."
          ></textarea>
        </div>

        <!-- Estado del formulario -->
        <div id="form-status" class="hidden mb-6 p-4 text-sm font-heading uppercase tracking-wider" role="alert" aria-live="polite"></div>

        <!-- Aviso de privacidad -->
        <p class="text-bone-muted text-xs mb-6 leading-relaxed">
          Al enviar este formulario aceptás que utilicemos tu email únicamente para responderte.
          No compartimos tus datos con terceros ni te enviamos correos no solicitados.
        </p>

        <button
          type="submit"
          id="submit-btn"
          class="btn-primary w-full"
          data-umami-event="submit_contact_form"
        >
          Enviar mensaje
        </button>
      </form>
    </div>
  </section>
    </Fragment>
  )}
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusDiv = document.getElementById("form-status")!;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  function showStatus(message: string, type: "success" | "error") {
    statusDiv.textContent = message;
    statusDiv.className = `mb-6 p-4 text-sm font-heading uppercase tracking-wider border ${
      type === "success"
        ? "border-green-600 text-green-400 bg-green-900/20"
        : "border-red-band text-red-band bg-red-900/20"
    }`;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Enviando...";

    const data = {
      name: (form.elements.namedItem("name") as HTMLInputElement).value,
      email: (form.elements.namedItem("email") as HTMLInputElement).value,
      contact_type: (form.elements.namedItem("contact_type") as HTMLSelectElement).value,
      message: (form.elements.namedItem("message") as HTMLTextAreaElement).value,
    };

    try {
      const res = await fetch("/api/submit-contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        showStatus("¡Mensaje enviado! Te responderemos a la brevedad.", "success");
        form.reset();
      } else {
        const body = await res.json().catch(() => ({}));
        showStatus(body.message || "Error al enviar. Intentá de nuevo.", "error");
      }
    } catch {
      showStatus("Error de conexión. Revisá tu internet e intentá de nuevo.", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Enviar mensaje";
    }
  });
</script>
