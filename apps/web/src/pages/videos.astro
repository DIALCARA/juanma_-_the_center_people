---
import BaseLayout from "../layouts/BaseLayout.astro";
import YouTubeEmbed from "../components/ui/YouTubeEmbed.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import SectionUnavailable from "../components/ui/SectionUnavailable.astro";
import { getMedia, getMediaCategories, getSectionInfo } from "../lib/api";

const section = await getSectionInfo("videos");

const page = Number(Astro.url.searchParams.get("page") ?? "1");
const category = Astro.url.searchParams.get("categoria") ?? "";

let mediaData: any = null;
let categoriesWithContent: Array<{ slug: string; name: string; count: number }> = [];
if (section.isEnabled) {
  try {
    const [media, cats] = await Promise.all([
      getMedia({ type: "video", category, page, page_size: 12 }),
      getMediaCategories("video"),
    ]);
    mediaData = media.data;
    categoriesWithContent = cats.data ?? [];
  } catch (e) {}
}

const items = mediaData?.items ?? [];
const total = mediaData?.total ?? 0;
const totalPages = Math.ceil(total / 12);

function extractYoutubeId(url: string): string | null {
  if (!url) return null;
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{11})/);
  return match?.[1] ?? null;
}
---

<BaseLayout
  title={section.title || "Videos"}
  description="Videoclips y presentaciones de Juanma & The Center People"
  breadcrumbs={[{ name: "Inicio", url: "/" }, { name: "Videos", url: "/videos" }]}
>
  {!section.isEnabled && (
    <SectionUnavailable title={section.title || "Videos"} message={section.message} />
  )}
  {section.isEnabled && (
    <Fragment>
  <!-- CABECERA -->
  <section class="py-20 px-4 text-center" aria-label="Videos">
    <div class="max-w-3xl mx-auto">
      <p class="font-heading text-red-band text-xs uppercase tracking-widest mb-3">Audiovisual</p>
      <h1 class="font-heading text-5xl md:text-6xl text-bone uppercase tracking-widest mb-6">
        Videos
      </h1>
      {total > 0 && (
        <p class="text-bone-muted font-light">{total} videos</p>
      )}
    </div>
  </section>

  <!-- FILTROS POR CATEGORÍA -->
  {categoriesWithContent.length > 0 && (
    <nav class="px-4 mb-2" aria-label="Filtrar videos por categoría">
      <ul class="max-w-7xl mx-auto flex flex-wrap justify-center gap-2" role="list">
        <li>
          <a
            href="/videos"
            class:list={[
              "inline-block px-4 py-1.5 text-xs font-heading uppercase tracking-wider border transition-colors",
              category === ""
                ? "border-red-band text-red-band"
                : "border-urban-800 text-bone-muted hover:text-bone hover:border-urban-600",
            ]}
            aria-current={category === "" ? "page" : undefined}
          >
            Todos
          </a>
        </li>
        {categoriesWithContent.map((cat) => (
          <li>
            <a
              href={`/videos?categoria=${cat.slug}`}
              class:list={[
                "inline-block px-4 py-1.5 text-xs font-heading uppercase tracking-wider border transition-colors",
                category === cat.slug
                  ? "border-red-band text-red-band"
                  : "border-urban-800 text-bone-muted hover:text-bone hover:border-urban-600",
              ]}
              aria-current={category === cat.slug ? "page" : undefined}
            >
              {cat.name} <span class="text-urban-600">({cat.count})</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <!-- GRID DE VIDEOS -->
  <section class="py-8 px-4 reveal" aria-label="Galería de videos">
    <div class="max-w-7xl mx-auto">
      {items.length > 0 ? (
        <>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {items.map((item: any) => {
              const youtubeId = extractYoutubeId(item.source_url || "");
              return (
                <article class="border border-urban-800 p-4 hover:border-urban-600 transition-colors">
                  {youtubeId ? (
                    <YouTubeEmbed videoId={youtubeId} title={item.title || "Video"} />
                  ) : item.thumbnail_url ? (
                    <div class="aspect-video bg-urban-900 flex items-center justify-center">
                      <img
                        src={item.thumbnail_url}
                        alt={item.alt_text || item.title || "Video"}
                        loading="lazy"
                        class="w-full h-full object-cover"
                      />
                    </div>
                  ) : null}
                  {item.title && (
                    <h3 class="font-heading text-bone uppercase tracking-wider text-xs mt-3">{item.title}</h3>
                  )}
                  {item.description && (
                    <p class="text-bone-muted text-xs mt-1 font-light">{item.description}</p>
                  )}
                </article>
              );
            })}
          </div>

          {totalPages > 1 && (
            <nav class="flex justify-center gap-4 mt-12" aria-label="Paginación">
              {page > 1 && (
                <a href={`/videos?page=${page - 1}${category ? `&categoria=${category}` : ""}`} class="btn-ghost text-sm">← Anterior</a>
              )}
              <span class="text-bone-muted text-sm font-heading uppercase tracking-wider self-center">
                {page} / {totalPages}
              </span>
              {page < totalPages && (
                <a href={`/videos?page=${page + 1}${category ? `&categoria=${category}` : ""}`} class="btn-ghost text-sm">Siguiente →</a>
              )}
            </nav>
          )}
        </>
      ) : (
        <EmptyState message="Los videos se publicarán próximamente." />
      )}
    </div>
  </section>
    </Fragment>
  )}
</BaseLayout>
