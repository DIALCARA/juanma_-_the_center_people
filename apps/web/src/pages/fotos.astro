---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import SectionUnavailable from "../components/ui/SectionUnavailable.astro";
import { getMedia, getMediaCategories, getSectionInfo } from "../lib/api";

const section = await getSectionInfo("fotos");

const page = Number(Astro.url.searchParams.get("page") ?? "1");
const category = Astro.url.searchParams.get("categoria") ?? "";

let mediaData: any = null;
let categoriesWithContent: Array<{ slug: string; name: string; count: number }> = [];
if (section.isEnabled) {
  try {
    const [media, cats] = await Promise.all([
      getMedia({ type: "image", category, page, page_size: 24 }),
      getMediaCategories("image"),
    ]);
    mediaData = media.data;
    categoriesWithContent = cats.data ?? [];
  } catch (e) {}
}

const items = mediaData?.items ?? [];
const total = mediaData?.total ?? 0;
const totalPages = Math.ceil(total / 24);
---

<BaseLayout title={section.title || "Fotos"} description="Galería de fotografías de Juanma & The Center People">
  {!section.isEnabled && (
    <SectionUnavailable title={section.title || "Fotos"} message={section.message} />
  )}
  {section.isEnabled && (
    <Fragment>
  <!-- CABECERA -->
  <section class="py-20 px-4 text-center" aria-label="Fotos">
    <div class="max-w-3xl mx-auto">
      <p class="font-heading text-red-band text-xs uppercase tracking-widest mb-3">Galería</p>
      <h1 class="font-heading text-5xl md:text-6xl text-bone uppercase tracking-widest mb-6">
        Fotos
      </h1>
      {total > 0 && (
        <p class="text-bone-muted font-light">{total} fotografías</p>
      )}
    </div>
  </section>

  <!-- FILTROS POR CATEGORÍA -->
  {categoriesWithContent.length > 0 && (
    <nav class="px-4 mb-2" aria-label="Filtrar fotos por categoría">
      <ul class="max-w-7xl mx-auto flex flex-wrap justify-center gap-2" role="list">
        <li>
          <a
            href="/fotos"
            class:list={[
              "inline-block px-4 py-1.5 text-xs font-heading uppercase tracking-wider border transition-colors",
              category === ""
                ? "border-red-band text-red-band"
                : "border-urban-800 text-bone-muted hover:text-bone hover:border-urban-600",
            ]}
            aria-current={category === "" ? "page" : undefined}
          >
            Todas
          </a>
        </li>
        {categoriesWithContent.map((cat) => (
          <li>
            <a
              href={`/fotos?categoria=${cat.slug}`}
              class:list={[
                "inline-block px-4 py-1.5 text-xs font-heading uppercase tracking-wider border transition-colors",
                category === cat.slug
                  ? "border-red-band text-red-band"
                  : "border-urban-800 text-bone-muted hover:text-bone hover:border-urban-600",
              ]}
              aria-current={category === cat.slug ? "page" : undefined}
            >
              {cat.name} <span class="text-urban-600">({cat.count})</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <!-- GALERÍA -->
  <section class="py-8 px-4 reveal" aria-label="Galería de fotos">
    <div class="max-w-7xl mx-auto">
      {items.length > 0 ? (
        <>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2" id="gallery">
            {items.map((item: any, i: number) => (
              <button
                class="card-media aspect-square cursor-zoom-in group"
                data-src={item.file_url}
                data-alt={item.alt_text || item.title || "Foto de la banda"}
                data-index={i}
                aria-label={`Ver foto: ${item.alt_text || item.title || "Foto de la banda"}`}
              >
                <img
                  src={item.thumbnail_url || item.file_url}
                  alt={item.alt_text || item.title || "Foto de la banda"}
                  width="400"
                  height="400"
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </button>
            ))}
          </div>

          <!-- PAGINACIÓN -->
          {totalPages > 1 && (
            <nav class="flex justify-center gap-4 mt-12" aria-label="Paginación">
              {page > 1 && (
                <a href={`/fotos?page=${page - 1}${category ? `&categoria=${category}` : ""}`} class="btn-ghost text-sm">
                  ← Anterior
                </a>
              )}
              <span class="text-bone-muted text-sm font-heading uppercase tracking-wider self-center">
                {page} / {totalPages}
              </span>
              {page < totalPages && (
                <a href={`/fotos?page=${page + 1}${category ? `&categoria=${category}` : ""}`} class="btn-ghost text-sm">
                  Siguiente →
                </a>
              )}
            </nav>
          )}
        </>
      ) : (
        <EmptyState message="Las fotos se publicarán próximamente." />
      )}
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div
    id="lightbox"
    class="fixed inset-0 z-50 bg-black/95 hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Vista ampliada"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-4 text-bone-muted hover:text-bone text-3xl font-light"
      aria-label="Cerrar"
    >
      ×
    </button>
    <button
      id="lightbox-prev"
      class="absolute left-4 top-1/2 -translate-y-1/2 text-bone-muted hover:text-bone text-4xl font-light"
      aria-label="Anterior"
    >
      ‹
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-w-full max-h-[90vh] object-contain"
    />
    <button
      id="lightbox-next"
      class="absolute right-4 top-1/2 -translate-y-1/2 text-bone-muted hover:text-bone text-4xl font-light"
      aria-label="Siguiente"
    >
      ›
    </button>
  </div>
    </Fragment>
  )}
</BaseLayout>

<script>
  const gallery = document.getElementById("gallery");
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");

  let currentIndex = 0;
  const buttons = gallery?.querySelectorAll("button[data-src]") ?? [];
  const items = Array.from(buttons).map((b) => ({
    src: b.getAttribute("data-src") ?? "",
    alt: b.getAttribute("data-alt") ?? "",
  }));

  function openLightbox(index: number) {
    currentIndex = index;
    if (!lightboxImg || !lightbox) return;
    lightboxImg.src = items[index].src;
    lightboxImg.alt = items[index].alt;
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
    lightboxImg.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  }

  function navigate(delta: number) {
    currentIndex = (currentIndex + delta + items.length) % items.length;
    if (lightboxImg) {
      lightboxImg.src = items[currentIndex].src;
      lightboxImg.alt = items[currentIndex].alt;
    }
  }

  buttons.forEach((btn, i) => {
    btn.addEventListener("click", () => openLightbox(i));
  });
  closeBtn?.addEventListener("click", closeLightbox);
  prevBtn?.addEventListener("click", () => navigate(-1));
  nextBtn?.addEventListener("click", () => navigate(1));
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (!lightbox?.classList.contains("flex")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") navigate(-1);
    if (e.key === "ArrowRight") navigate(1);
  });
</script>
